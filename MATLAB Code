       fprintf('\n>>> Running Downlink Demo at %d dB SNR...\n', snrVal);
       dcs_downlink_live_demo_customSNR(snrVal);
   end
   function runMIMO(~)
       fprintf('\n>>> Running MIMO-OFDM Simulation...\n');
       main_mimo_ofdm;
   end
   function runCompare(~)
       fprintf('\n>>> Running BER Comparison...\n');
       evalin('base','comparison_methods');
